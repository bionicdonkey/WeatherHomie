# Bootstrap only. Everything else (locations, sources, credentials, alerts) is managed in the UI.

# REQUIRED. Encrypts stored secrets (AES-256-GCM). Generate: python -m stormtracker.cli generate-key
# If you lose this key, stored secrets cannot be recovered and must be re-entered.
MASTER_KEY=

# Optional: create the admin account on first start. If unset, a one-time setup token is logged instead.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=          # at least 12 characters (shorter is ignored and the setup token is used instead)

# Optional overrides
#DATABASE_URL=sqlite+aiosqlite:////data/stormtracker.db   # or postgresql+asyncpg://user:pass@host/db
#HTTP_PORT=8000
# Set false only when serving over plain HTTP on a trusted LAN (cookie 'Secure' flag)
COOKIE_SECURE=false

# Optional SSO behind a reverse proxy (e.g. Authentik): header carrying the username, and proxy IPs to trust
#TRUSTED_AUTH_HEADER=X-authentik-username
#TRUSTED_PROXIES=172.18.0.1
